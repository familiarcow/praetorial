{
  "repo": "<repo url or 'local git, no remote'>",
  "commit": "<40-hex git commit that was built>",
  "image": "outlayer/wasmedge-compiler",
  "image_digest": "sha256:<64-hex pinned compiler image digest>",
  "platform": "linux/amd64",
  "target": "wasm32-wasip2",
  "features": "real-http,outlayer-sign",
  "hash": "<64-hex sha256 of the wasm, identical in every build>",
  "builds": [
    {"route": "docker-run-1", "sha256": "<64-hex>"},
    {"route": "docker-run-2", "sha256": "<64-hex>"},
    {"route": "fresh-container", "sha256": "<64-hex>"}
  ]
}
