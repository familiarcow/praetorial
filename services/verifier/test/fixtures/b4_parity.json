{
 "_comment": "V1b parity vectors for element_verdict_q (D-ORIGIN1 / D-EXH1 origin corroboration). Asserted by judge-proto/test_verifier_b4_parity.py (judge.py), resolver/core/tests/verifier_b4_parity.rs (Rust core) and services/verifier/test/b4.test.ts (TS port).",
 "cases": [
  {"name": "single origin decisive YES -> insufficient", "quorum": true,
   "sources": [{"id": "A", "url": "https://forecast.weather.gov/x", "publisher": "NWS"}],
   "results": [["met", "A"]], "expect": "insufficient"},
  {"name": "two distinct origins -> met", "quorum": true,
   "sources": [{"id": "A", "url": "https://forecast.weather.gov/x", "publisher": "NWS"}, {"id": "B", "url": "https://mesonet.agron.iastate.edu/y", "publisher": "IEM"}],
   "results": [["met", "A,B"]], "expect": "met"},
  {"name": "same registrable domain, two subdomains -> one origin -> insufficient", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x", "publisher": "A"}, {"id": "B", "url": "https://www.example.org/y", "publisher": "B"}],
   "results": [["met", "A,B"]], "expect": "insufficient"},
  {"name": "declared origin merges two domains into one -> insufficient", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x", "origin": "wire"}, {"id": "B", "url": "https://b.example.net/y", "origin": "wire"}],
   "results": [["met", "A,B"]], "expect": "insufficient"},
  {"name": "not_met on two origins -> not_proven", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x", "publisher": "Pub A"}, {"id": "B", "url": "https://b.example.net/y", "publisher": "Pub B"}],
   "results": [["not_met", "A,B"]], "expect": "not_proven"},
  {"name": "met vs not_proven on different origins -> conflict", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x", "publisher": "Pub A"}, {"id": "B", "url": "https://b.example.net/y", "publisher": "Pub B"}],
   "results": [["met", "A"], ["not_met", "B"]], "expect": "conflict"},
  {"name": "no quorum (curated lane) single origin met stays met", "quorum": false,
   "sources": [{"id": "A", "url": "https://statsapi.mlb.com/api/v1/schedule?x=1"}],
   "results": [["met", "A"]], "expect": "met"},
  {"name": "only party-controlled citations cannot be met", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x", "party_controlled": true}, {"id": "B", "url": "https://b.example.net/y", "party_controlled": true}],
   "results": [["met", "A,B"]], "expect": "unresolved"},
  {"name": "an invalid answer makes the element unresolved", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x"}],
   "results": [["met", "A"], ["invalid", null]], "expect": "unresolved"},
  {"name": "only empty answers are unresolved", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x"}],
   "results": [["empty", null]], "expect": "unresolved"},
  {"name": "insufficient stays insufficient", "quorum": true,
   "sources": [{"id": "A", "url": "https://a.example.org/x"}],
   "results": [["insufficient", null]], "expect": "insufficient"}
 ]
}
