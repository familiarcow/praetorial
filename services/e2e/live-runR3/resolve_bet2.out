	Log [praetorial-r3c-11061912.praetorial-dev-1101.testnet]: EVENT_JSON:{"standard":"near-outlayer","version":"1.0.0","event":"execution_requested","data":[{"request_data":"{\"request_id\":11309,\"sender_id\":\"keeper.praetorial-dev-1101.testnet\",\"predecessor_id\":\"praetorial-r3c-11061912.praetorial-dev-1101.testnet\",\"code_source\":{\"WasmUrl\":{\"url\":\"https://test.fastfs.io/praetorial-dev-1101.testnet/outlayer.testnet/4a69b059fb530b383af9c8ad711f9facf1f8bae3b20398a5ccdd05c330808338.wasm\",\"hash\":\"4a69b059fb530b383af9c8ad711f9facf1f8bae3b20398a5ccdd05c330808338\",\"build_target\":\"wasm32-wasip2\"}},\"resource_limits\":{\"max_instructions\":500000000000,\"max_memory_mb\":128,\"max_execution_seconds\":150},\"input_data\":\"{\\\"contract\\\":\\\"praetorial-r3c-11061912.praetorial-dev-1101.testnet\\\",\\\"bet_id\\\":2,\\\"envelope\\\":{\\\"bet_id\\\":2,\\\"version\\\":1,\\\"maker\\\":\\\"maker1.praetorial-dev-1101.testnet\\\",\\\"taker_allow\\\":\\\"Any\\\",\\\"terms_hash\\\":\\\"239a6e05754e47cb03d5178ff8cb1150c16796cbd8bc5d23b38583f1ecea2cd8\\\",\\\"models_snapshot_hash\\\":\\\"itemR3c-knyc\\\",\\\"outcomes\\\":[\\\"YES\\\",\\\"NO\\\"],\\\"maker_side\\\":\\\"YES\\\",\\\"maker_asset\\\":\\\"nep141:usdc.testnet\\\",\\\"taker_asset\\\":\\\"nep141:usdc.testnet\\\",\\\"stake_maker\\\":\\\"1000000\\\",\\\"stake_taker\\\":\\\"1000000\\\",\\\"taker_options\\\":[],\\\"fee_bps\\\":100,\\\"storage_charge_per_side\\\":\\\"8000\\\",\\\"keep_terms\\\":true,\\\"terms\\\":\\\"{\\\\n \\\\\\\"_comment\\\\\\\": \\\\\\\"R3c: KNYC 2026-11-05 daily high >= 70F (known answer 72F -> YES). Term sheet for the D-JUDGE4 live run.\\\\\\\",\\\\n \\\\\\\"claim\\\\\\\": \\\\\\\"The NWS Climatological Report (Daily) for Central Park NY (KNYC) for 2026-11-05 shows a maximum temperature of at least 70 degrees Fahrenheit.\\\\\\\",\\\\n \\\\\\\"elements\\\\\\\": [\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"e1\\\\\\\",\\\\n   \\\\\\\"q\\\\\\\": \\\\\\\"Does the NWS Climatological Report (Daily) for Central Park NY (KNYC) show a maximum temperature of 70 F or higher for 2026-11-05?\\\\\\\"\\\\n  }\\\\n ],\\\\n \\\\\\\"rule\\\\\\\": \\\\\\\"ALL\\\\\\\",\\\\n \\\\\\\"clauses\\\\\\\": [\\\\n  \\\\\\\"UTC_V1\\\\\\\",\\\\n  \\\\\\\"NUMERIC_EXACT_V1\\\\\\\",\\\\n  \\\\\\\"NO_DATA_FALLBACK_V1\\\\\\\",\\\\n  \\\\\\\"CORRECTED_V1\\\\\\\"\\\\n ],\\\\n \\\\\\\"custom_definitions\\\\\\\": [\\\\n  \\\\\\\"The deciding figure is the MAXIMUM temperature (F) for the calendar day 2026-11-05 in the final CLI report for KNYC, the report issued on 2026-11-06 at 145 AM EST where 2026-11-05 is YESTERDAY. A preliminary same-day report (TODAY, valid as of an afternoon time) is not final.\\\\\\\",\\\\n  \\\\\\\"The two sources are two independent copies of the NWS CLI product CLINYC: the NWS forecast office page (weather.gov) and the Iowa Environmental Mesonet archive of the same product. If they disagree on the maximum the sources conflict.\\\\\\\",\\\\n  \\\\\\\"Early resolution: YES may be declared as soon as the final report is published; NO only from the final report.\\\\\\\",\\\\n  \\\\\\\"Fallback: if one named source is unreachable, the other named source alone may decide; if neither can be read the outcome is VOID with full refunds.\\\\\\\",\\\\n  \\\\\\\"Burden of proof is on YES: a figure that is not shown in the final report resolves NO.\\\\\\\"\\\\n ],\\\\n \\\\\\\"time\\\\\\\": {\\\\n  \\\\\\\"window_start\\\\\\\": \\\\\\\"2026-11-05T05:00:00Z\\\\\\\",\\\\n  \\\\\\\"window_end\\\\\\\": \\\\\\\"2026-11-06T04:59:59Z\\\\\\\",\\\\n  \\\\\\\"evidence_cutoff\\\\\\\": \\\\\\\"2026-11-06T12:00:00Z\\\\\\\"\\\\n },\\\\n \\\\\\\"sources_allowed\\\\\\\": [\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"S_NWS\\\\\\\",\\\\n   \\\\\\\"publisher\\\\\\\": \\\\\\\"NWS weather.gov CLI KNYC\\\\\\\",\\\\n   \\\\\\\"url\\\\\\\": \\\\\\\"https://forecast.weather.gov/product.php?site=OKX&product=CLI&issuedby=NYC&version=2&glossary=0\\\\\\\"\\\\n  },\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"S_IEM\\\\\\\",\\\\n   \\\\\\\"publisher\\\\\\\": \\\\\\\"IEM nwstext CLI KNYC\\\\\\\",\\\\n   \\\\\\\"url\\\\\\\": \\\\\\\"https://mesonet.agron.iastate.edu/api/1/nwstext/202611060645-KOKX-CDUS41-CLINYC\\\\\\\"\\\\n  }\\\\n ],\\\\n \\\\\\\"source_classes\\\\\\\": {\\\\n  \\\\\\\"NWS weather.gov CLI KNYC\\\\\\\": \\\\\\\"primary\\\\\\\",\\\\n  \\\\\\\"IEM nwstext CLI KNYC\\\\\\\": \\\\\\\"primary\\\\\\\"\\\\n },\\\\n \\\\\\\"window_close\\\\\\\": \\\\\\\"2026-11-06T12:00:00Z\\\\\\\",\\\\n \\\\\\\"sources\\\\\\\": true\\\\n}\\\",\\\"max_paid_runs\\\":2,\\\"tier\\\":1,\\\"referee\\\":null,\\\"funding_deadline\\\":1794011546949000000,\\\"early_settle_outcome\\\":null,\\\"finality_delay\\\":0,\\\"settlement_period\\\":3600000000000,\\\"resolve_deadline\\\":1796603396949000000,\\\"consent_party_controlled\\\":false},\\\"terms\\\":\\\"{\\\\n \\\\\\\"_comment\\\\\\\": \\\\\\\"R3c: KNYC 2026-11-05 daily high >= 70F (known answer 72F -> YES). Term sheet for the D-JUDGE4 live run.\\\\\\\",\\\\n \\\\\\\"claim\\\\\\\": \\\\\\\"The NWS Climatological Report (Daily) for Central Park NY (KNYC) for 2026-11-05 shows a maximum temperature of at least 70 degrees Fahrenheit.\\\\\\\",\\\\n \\\\\\\"elements\\\\\\\": [\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"e1\\\\\\\",\\\\n   \\\\\\\"q\\\\\\\": \\\\\\\"Does the NWS Climatological Report (Daily) for Central Park NY (KNYC) show a maximum temperature of 70 F or higher for 2026-11-05?\\\\\\\"\\\\n  }\\\\n ],\\\\n \\\\\\\"rule\\\\\\\": \\\\\\\"ALL\\\\\\\",\\\\n \\\\\\\"clauses\\\\\\\": [\\\\n  \\\\\\\"UTC_V1\\\\\\\",\\\\n  \\\\\\\"NUMERIC_EXACT_V1\\\\\\\",\\\\n  \\\\\\\"NO_DATA_FALLBACK_V1\\\\\\\",\\\\n  \\\\\\\"CORRECTED_V1\\\\\\\"\\\\n ],\\\\n \\\\\\\"custom_definitions\\\\\\\": [\\\\n  \\\\\\\"The deciding figure is the MAXIMUM temperature (F) for the calendar day 2026-11-05 in the final CLI report for KNYC, the report issued on 2026-11-06 at 145 AM EST where 2026-11-05 is YESTERDAY. A preliminary same-day report (TODAY, valid as of an afternoon time) is not final.\\\\\\\",\\\\n  \\\\\\\"The two sources are two independent copies of the NWS CLI product CLINYC: the NWS forecast office page (weather.gov) and the Iowa Environmental Mesonet archive of the same product. If they disagree on the maximum the sources conflict.\\\\\\\",\\\\n  \\\\\\\"Early resolution: YES may be declared as soon as the final report is published; NO only from the final report.\\\\\\\",\\\\n  \\\\\\\"Fallback: if one named source is unreachable, the other named source alone may decide; if neither can be read the outcome is VOID with full refunds.\\\\\\\",\\\\n  \\\\\\\"Burden of proof is on YES: a figure that is not shown in the final report resolves NO.\\\\\\\"\\\\n ],\\\\n \\\\\\\"time\\\\\\\": {\\\\n  \\\\\\\"window_start\\\\\\\": \\\\\\\"2026-11-05T05:00:00Z\\\\\\\",\\\\n  \\\\\\\"window_end\\\\\\\": \\\\\\\"2026-11-06T04:59:59Z\\\\\\\",\\\\n  \\\\\\\"evidence_cutoff\\\\\\\": \\\\\\\"2026-11-06T12:00:00Z\\\\\\\"\\\\n },\\\\n \\\\\\\"sources_allowed\\\\\\\": [\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"S_NWS\\\\\\\",\\\\n   \\\\\\\"publisher\\\\\\\": \\\\\\\"NWS weather.gov CLI KNYC\\\\\\\",\\\\n   \\\\\\\"url\\\\\\\": \\\\\\\"https://forecast.weather.gov/product.php?site=OKX&product=CLI&issuedby=NYC&version=2&glossary=0\\\\\\\"\\\\n  },\\\\n  {\\\\n   \\\\\\\"id\\\\\\\": \\\\\\\"S_IEM\\\\\\\",\\\\n   \\\\\\\"publisher\\\\\\\": \\\\\\\"IEM nwstext CLI KNYC\\\\\\\",\\\\n   \\\\\\\"url\\\\\\\": \\\\\\\"https://mesonet.agron.iastate.edu/api/1/nwstext/202611060645-KOKX-CDUS41-CLINYC\\\\\\\"\\\\n  }\\\\n ],\\\\n \\\\\\\"source_classes\\\\\\\": {\\\\n  \\\\\\\"NWS weather.gov CLI KNYC\\\\\\\": \\\\\\\"primary\\\\\\\",\\\\n  \\\\\\\"IEM nwstext CLI KNYC\\\\\\\": \\\\\\\"primary\\\\\\\"\\\\n },\\\\n \\\\\\\"window_close\\\\\\\": \\\\\\\"2026-11-06T12:00:00Z\\\\\\\",\\\\n \\\\\\\"sources\\\\\\\": true\\\\n}\\\",\\\"round\\\":0,\\\"run_no\\\":1,\\\"payer_account_id\\\":\\\"keeper.praetorial-dev-1101.testnet\\\"}\",\"input_data_in_state